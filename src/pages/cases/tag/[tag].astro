---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('cases', ({ data }) => !data.draft);
  const tags = new Set<string>();
  posts.forEach((p) => p.data.tags.forEach((t) => tags.add(t)));
  return Array.from(tags).map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props;
const sorted = posts.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
const fmt = (d: Date) => d.toLocaleDateString('zh-TW', { year:'numeric', month:'2-digit', day:'2-digit' });
---
<Base title={`${tag}相關案例`} description={`張瑋麟中醫師「${tag}」相關的臨床治療案例。`}>
  <section class="section">
    <div class="wrap wrap-narrow">
      <p style="text-align:center; margin-bottom:0.5rem;"><a href="/cases/">← 回所有案例</a></p>
      <h1 style="text-align:center;">「{tag}」相關案例</h1>
      <p style="text-align:center; color:var(--color-muted); margin-bottom:2.5rem;">共 {sorted.length} 篇</p>
      {sorted.map((post) => (
        <div class="post-list-item">
          {post.data.cover ? (
            <img src={post.data.cover} alt={post.data.title} class="post-list-item__cover" loading="lazy" />
          ) : (
            <div class="post-list-item__cover" style="display:flex;align-items:center;justify-content:center;font-size:2rem;color:var(--color-muted);">📋</div>
          )}
          <div>
            <div class="post-card__date">{fmt(post.data.publishDate)}</div>
            <h2 style="font-size:1.2rem; margin:0.4rem 0 0.5rem;"><a href={`/cases/${post.slug}/`}>{post.data.title}</a></h2>
            <p style="color:var(--color-ink-soft); font-size:0.93rem; line-height:1.7;">{post.data.description}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>
