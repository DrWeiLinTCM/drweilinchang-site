---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { SITE } from '@/config';

const allCases = await getCollection('cases', ({ data }) => !data.draft);
const recentCases = allCases.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()).slice(0, 3);

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const recentArticles = allArticles.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()).slice(0, 3);

// 收集所有醫案標籤 → 用來判斷細項要不要變連結
const existingTags = new Set<string>();
allCases.forEach((p) => p.data.tags.forEach((t) => existingTags.add(t)));

const fmtDate = (d: Date) => d.toLocaleDateString('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' });
---

<Base>
  <!-- ===== Hero ===== -->
  <section class:list={['hero', { 'hero--no-image': !SITE.hero.backgroundImage }]}>
    <div class="hero__bg" style={SITE.hero.backgroundImage ? `background-image: url('${SITE.hero.backgroundImage}')` : undefined}></div>
    <div class="hero__content">
      <h1 class="hero__headline">{SITE.hero.headline}</h1>
      <p class="hero__tagline">{SITE.hero.tagline}</p>
      <p class="hero__desc">{SITE.hero.description}</p>
      <div class="hero-search">
        <input
          type="search"
          id="heroSearch"
          class="hero-search__input"
          placeholder="輸入症狀或疾病，搜尋醫案與健康知識…"
          autocomplete="off"
          aria-label="搜尋醫案與健康知識"
          aria-controls="heroSearchResults"
        />
        <div id="heroSearchResults" class="hero-search__results" role="region" aria-label="搜尋結果" aria-live="polite" hidden></div>
      </div>
    </div>
  </section>

  <script>
    (() => {
      const input = document.querySelector<HTMLInputElement>('#heroSearch');
      const box = document.getElementById('heroSearchResults');
      const root = input?.closest<HTMLElement>('.hero-search');
      if (!input || !box || !root) return;

      type SearchItem = { type: string; title: string; description: string; tags: string[]; url: string };
      let indexPromise: Promise<SearchItem[]> | undefined;
      let requestId = 0;

      function loadIndex(): Promise<SearchItem[]> {
        if (!indexPromise) {
          indexPromise = (async () => {
            const res = await fetch('/search-index.json');
            if (!res.ok || !res.headers.get('content-type')?.includes('application/json')) {
              throw new Error('Search index unavailable');
            }
            const data = await res.json();
            if (!Array.isArray(data) || !data.every((item) =>
              item && typeof item.type === 'string' && typeof item.title === 'string' &&
              typeof item.description === 'string' && typeof item.url === 'string' &&
              /^\/(cases|articles)\/[^?#]+\/$/.test(item.url) &&
              Array.isArray(item.tags) && item.tags.every((tag) => typeof tag === 'string')
            )) throw new Error('Invalid search index');
            return data;
          })().catch((error) => {
            indexPromise = undefined;
            throw error;
          });
        }
        return indexPromise;
      }

      function showMessage(message: string) {
        const messageBox = document.createElement('div');
        messageBox.className = 'hero-search__empty';
        messageBox.textContent = message;
        box.replaceChildren(messageBox);
        box.hidden = false;
      }

      function render(results: SearchItem[]) {
        if (results.length === 0) {
          showMessage('找不到相關文章，歡迎透過 LINE 直接詢問');
          return;
        }
        const links = results.slice(0, 8).map((result) => {
          const link = document.createElement('a');
          link.href = result.url;
          link.className = `hero-search__item hero-search__item--${result.type === '案例' ? 'case' : 'article'}`;
          const type = document.createElement('span');
          type.className = `hero-search__type hero-search__type--${result.type === '案例' ? 'case' : 'article'}`;
          type.textContent = result.type === '案例' ? '治療案例' : '健康知識';
          const title = document.createElement('span');
          title.className = 'hero-search__title';
          title.textContent = result.title;
          link.append(type, title);
          return link;
        });
        const summary = document.createElement('div');
        summary.className = 'hero-search__summary';
        summary.textContent = `找到 ${results.length} 筆結果${results.length > links.length ? `，顯示前 ${links.length} 筆` : ''}`;
        box.replaceChildren(summary, ...links);
        box.hidden = false;
      }

      async function search(keyword: string, id: number) {
        if (!keyword) { box.hidden = true; return; }
        showMessage('搜尋中…');
        try {
          const data = await loadIndex();
          if (id !== requestId) return;
          const query = keyword.toLocaleLowerCase('zh-TW');
          render(data.filter((item) =>
            [item.title, item.description, ...item.tags].some((text) => text.toLocaleLowerCase('zh-TW').includes(query))
          ));
        } catch {
          if (id === requestId) showMessage('搜尋暫時無法使用，請從下方主治項目瀏覽，或透過 LINE 詢問。');
        }
      }

      let timer: ReturnType<typeof setTimeout> | undefined;
      input.addEventListener('input', () => {
        clearTimeout(timer);
        const id = ++requestId;
        box.hidden = true;
        timer = setTimeout(() => { void search(input.value.trim(), id); }, 200);
      });

      input.addEventListener('focus', () => { void loadIndex().catch(() => {}); });
      input.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
          event.preventDefault();
          clearTimeout(timer);
          void search(input.value.trim(), ++requestId);
        } else if (event.key === 'ArrowDown' && !box.hidden) {
          const firstLink = box.querySelector('a');
          if (firstLink) { event.preventDefault(); firstLink.focus(); }
        }
      });
      function closeResults() {
        clearTimeout(timer);
        requestId++;
        box.hidden = true;
      }
      root.addEventListener('keydown', (event: KeyboardEvent) => {
        if (event.key === 'Escape') { closeResults(); input.focus(); }
      });
      document.addEventListener('click', (e) => {
        if (e.target instanceof Node && !root.contains(e.target)) closeResults();
      });
    })();
  </script>

  <!-- 搜尋項目由瀏覽器動態建立，使用獨立 class 名稱的全域樣式。 -->
  <style is:global>
    .hero-search { position: relative; width: 100%; max-width: 560px; margin: 0 auto; }
    .hero-search__input {
      width: 100%; padding: 0.85rem 1.25rem; border-radius: 50px; border: none;
      font-size: 0.98rem; font-family: inherit; outline: none;
      box-shadow: 0 4px 20px rgba(0,0,0,0.25);
    }
    .hero-search__input:focus { box-shadow: 0 4px 24px rgba(59,169,156,0.45); }
    .hero-search__results {
      position: absolute; top: calc(100% + 12px); left: 0; right: 0;
      background: #F4F8F7; border: 1px solid var(--color-line); border-radius: 14px;
      padding: 0.65rem;
      box-shadow: 0 12px 40px rgba(0,0,0,0.2); z-index: 20;
      max-height: min(440px, 55vh); overflow-y: auto; overscroll-behavior: contain; text-align: left;
    }
    .hero-search__summary { padding: 0.1rem 0.35rem 0.65rem; font-size: 0.8rem; line-height: 1.5; color: var(--color-ink-soft); }
    .hero-search__item {
      display: grid; grid-template-columns: 4.5rem minmax(0, 1fr); align-items: start; gap: 0.8rem;
      padding: 1rem; margin-bottom: 0.65rem; color: var(--color-ink);
      background: #fff; border: 1px solid #DCE8E5; border-left: 4px solid #2D8F84;
      border-radius: 9px; text-decoration: none; transition: background 0.15s, border-color 0.15s;
    }
    .hero-search__item--article { background: #FFFBF2; border-left-color: #B07D2B; }
    .hero-search__item:last-child { margin-bottom: 0; }
    .hero-search__item:hover, .hero-search__item:focus-visible { background: #EAF5F2; border-color: #2D8F84; color: var(--color-ink); }
    .hero-search__item:focus-visible { outline: 2px solid #2D8F84; outline-offset: 2px; }
    .hero-search__type {
      display: inline-block; font-size: 0.74rem; padding: 0.25rem 0.4rem;
      border-radius: 5px; font-weight: 600; line-height: 1.6; text-align: center; white-space: nowrap;
    }
    .hero-search__type--case { background: #DFF1EC; color: #206E61; }
    .hero-search__type--article { background: #F9EBCB; color: #80580D; }
    .hero-search__title { display: block; padding-top: 0.1rem; color: var(--color-ink); font-size: 0.95rem; line-height: 1.75; overflow-wrap: anywhere; }
    .hero-search__empty { padding: 1.25rem 0.75rem; color: var(--color-ink-soft); font-size: 0.9rem; line-height: 1.75; text-align: center; }
    @media (max-width: 480px) {
      .hero-search__results { padding: 0.5rem; }
      .hero-search__item { grid-template-columns: minmax(0, 1fr); gap: 0.5rem; padding: 0.9rem; }
      .hero-search__type { justify-self: start; }
    }
  </style>

  <!-- ===== 主治項目 ===== -->
  <section class="section">
    <div class="wrap">
      <div class="section__eyebrow">Specialties</div>
      <h2 class="section__title">主治項目</h2>
      <p class="section__subtitle">點擊細項可查看相關治療案例</p>
      <div class="spec-grid spec-grid--five">
        {SITE.specialties.map((s) => (
          <div class="spec-card">
            <div class="spec-card__icon">{s.icon}</div>
            <h3 class="spec-card__title">{s.group}</h3>
            <ul class="spec-card__list">
              {s.items.map((item) => (
                <li>
                  {existingTags.has(item.tag) ? (
                    <a href={`/cases/tag/${item.tag}/`} class="spec-link">{item.label}</a>
                  ) : (
                    <span>{item.label}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== 治療方式 ===== -->
  <section class="section section--alt">
    <div class="wrap">
      <div class="section__eyebrow">Treatments</div>
      <h2 class="section__title">治療方式</h2>
      <div class="tx-grid">
        {SITE.treatments.map((t) => (
          <span class="tx-chip" title={t.description}>{t.name}</span>
        ))}
      </div>
      <p class="tx-note">🩹 怕針也能處理 — 可選擇 AMCT 整脊或中藥調理</p>
    </div>
  </section>

  <!-- ===== 最新案例 ===== -->
  <section class="section">
    <div class="wrap">
      <div class="section__eyebrow">Cases</div>
      <h2 class="section__title">最新案例</h2>
      {recentCases.length === 0 ? (
        <p style="text-align:center; color:var(--color-muted);">案例即將上線，敬請期待。</p>
      ) : (
        <div class="post-grid">
          {recentCases.map((post) => (
            <div class="post-card">
              {post.data.cover ? (
                <img src={post.data.cover} alt={post.data.coverAlt || post.data.title} class="post-card__cover" loading="lazy" />
              ) : (
                <div class="post-card__cover--placeholder">📋</div>
              )}
              <div class="post-card__body">
                <div class="post-card__date">{fmtDate(post.data.publishDate)}</div>
                <h3 class="post-card__title"><a href={`/cases/${post.slug}/`}>{post.data.title}</a></h3>
                <p class="post-card__desc">{post.data.description}</p>
                <a href={`/cases/${post.slug}/`} class="post-card__link">閱讀更多</a>
              </div>
            </div>
          ))}
        </div>
      )}
      {recentCases.length > 0 && (
        <div style="text-align:center;"><a href="/cases/" class="view-all">查看全部案例</a></div>
      )}
    </div>
  </section>

  <!-- ===== 健康知識 ===== -->
  <section class="section section--alt">
    <div class="wrap">
      <div class="section__eyebrow">Health Tips</div>
      <h2 class="section__title">健康知識</h2>
      {recentArticles.length === 0 ? (
        <p style="text-align:center; color:var(--color-muted);">衛教文章即將上線，敬請期待。</p>
      ) : (
        <div class="post-grid">
          {recentArticles.map((post) => (
            <div class="post-card">
              {post.data.cover ? (
                <img src={post.data.cover} alt={post.data.coverAlt || post.data.title} class="post-card__cover" loading="lazy" />
              ) : (
                <div class="post-card__cover--placeholder">📖</div>
              )}
              <div class="post-card__body">
                <div class="post-card__date">{fmtDate(post.data.publishDate)}</div>
                <h3 class="post-card__title"><a href={`/articles/${post.slug}/`}>{post.data.title}</a></h3>
                <p class="post-card__desc">{post.data.description}</p>
                <a href={`/articles/${post.slug}/`} class="post-card__link">閱讀更多</a>
              </div>
            </div>
          ))}
        </div>
      )}
      {recentArticles.length > 0 && (
        <div style="text-align:center;"><a href="/articles/" class="view-all">查看全部文章</a></div>
      )}
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="cta-banner">
    <h2>預約看診</h2>
    <p>點擊下方按鈕，透過 LINE 官方帳號預約掛號</p>
    <a href={SITE.clinic.lineUrl} target="_blank" rel="noopener" class="cta-banner__btn">LINE 立即預約</a>
  </section>

  <!-- ===== 診所資訊 + 看診時間 ===== -->
  <section class="clinic-section">
    <div class="clinic-grid">
      <div>
        <h3>📍 {SITE.clinic.fullName}</h3>
        <p>{SITE.clinic.address}</p>
        <p>電話：{SITE.clinic.phone}</p>
        {SITE.clinic.googleMapUrl && (
          <p><a href={SITE.clinic.googleMapUrl} target="_blank" rel="noopener">在 Google Maps 上查看 →</a></p>
        )}
      </div>
      <div>
        <h3>🕐 看診時間</h3>
        <table class="hours-table">
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">看診時段</span></th>
              {SITE.clinic.hours.map((h) => <th scope="col">{h.day}</th>)}
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row" style="text-align:left; font-size:0.82rem; color:rgba(255,255,255,0.5); white-space:nowrap;">{SITE.clinic.amTime}</th>
              {SITE.clinic.hours.map((h) => (
                <td><span class={`hours-dot hours-dot--${h.am ? 'on' : 'off'}`} aria-hidden="true"></span><span class="sr-only">{h.am ? '看診' : '無門診'}</span></td>
              ))}
            </tr>
            <tr>
              <th scope="row" style="text-align:left; font-size:0.82rem; color:rgba(255,255,255,0.5); white-space:nowrap;">{SITE.clinic.pmTime}</th>
              {SITE.clinic.hours.map((h) => (
                <td><span class={`hours-dot hours-dot--${h.pm ? 'on' : 'off'}`} aria-hidden="true"></span><span class="sr-only">{h.pm ? '看診' : '無門診'}</span></td>
              ))}
            </tr>
          </tbody>
        </table>
        <p style="font-size:0.8rem; margin-top:0.75rem;">綠點為看診時段；門診異動請以診所公告或 LINE 確認。</p>
      </div>
    </div>
  </section>
</Base>
