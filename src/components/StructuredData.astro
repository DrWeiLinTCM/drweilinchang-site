---
import { SITE } from '@/config';
interface Props { type?: 'website' | 'article'; title?: string; description?: string; publishDate?: Date; updatedDate?: Date; tags?: string[]; }
const { type = 'website', title = SITE.title, description = SITE.description, publishDate, updatedDate, tags = [] } = Astro.props;
const url = new URL(Astro.url.pathname, SITE.url).href;
const person = { '@type':'Person','@id':`${SITE.url}/#person`, name:SITE.doctor.fullName, alternateName:SITE.doctor.nameEn, jobTitle:SITE.doctor.jobTitle, description:SITE.doctor.bio, knowsAbout:SITE.doctor.knowsAbout, url:SITE.url, sameAs:SITE.doctor.sameAs, worksFor:{'@id':`${SITE.url}/#clinic`} };
const ws = { '@type':'WebSite','@id':`${SITE.url}/#website`, url:SITE.url, name:SITE.title, description:SITE.description, inLanguage:SITE.lang, author:{'@id':`${SITE.url}/#person`} };
const art = type==='article' ? { '@type':'Article', headline:title, description, url, ...(publishDate&&{datePublished:publishDate.toISOString()}), ...(updatedDate?{dateModified:updatedDate.toISOString()}:publishDate?{dateModified:publishDate.toISOString()}:{}), author:{'@id':`${SITE.url}/#person`}, inLanguage:SITE.lang, ...(tags.length>0&&{keywords:tags.join(', ')}) } : null;
const clinic = { '@type':'MedicalClinic', '@id':`${SITE.url}/#clinic`, name:SITE.clinic.fullName, telephone:SITE.clinic.telephoneE164, address:{ '@type':'PostalAddress', streetAddress:'延吉街153-2號4樓', addressLocality:'大安區', addressRegion:'台北市', addressCountry:'TW' }, hasMap:SITE.clinic.googleMapUrl, openingHoursSpecification:SITE.clinic.openingHoursSpecification };
const g=[ws,person,clinic]; if(art) g.push(art);
---
<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':g})} />
