---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { SITE } from '@/config';

const allCases = await getCollection('cases', ({ data }) => !data.draft);
const recentCases = allCases.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()).slice(0, 3);

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const recentArticles = allArticles.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()).slice(0, 3);

// 收集所有醫案標籤 → 用來判斷細項要不要變連結
const existingTags = new Set<string>();
allCases.forEach((p) => p.data.tags.forEach((t) => existingTags.add(t)));

const fmtDate = (d: Date) => d.toLocaleDateString('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' });
---

<Base>
  <!-- ===== Hero ===== -->
  <section class="hero">
    <div class="hero__bg" style={`background-image: url('${SITE.hero.backgroundImage}')`}></div>
    <div class="hero__content">
      <h1 class="hero__headline">{SITE.hero.headline}</h1>
      <p class="hero__tagline">{SITE.hero.tagline}</p>
      <p class="hero__desc">{SITE.hero.description}</p>
      <div class="hero-search">
        <input
          type="text"
          id="heroSearch"
          class="hero-search__input"
          placeholder="輸入症狀或疾病，搜尋醫案與健康知識…"
          autocomplete="off"
        />
        <div id="heroSearchResults" class="hero-search__results" hidden></div>
      </div>
    </div>
  </section>

  <script>
    (() => {
      const input = document.getElementById('heroSearch');
      const box = document.getElementById('heroSearchResults');
      let index = null;

      async function loadIndex() {
        if (index) return index;
        const res = await fetch('/search-index.json');
        index = await res.json();
        return index;
      }

      function render(results, keyword) {
        if (!keyword) { box.hidden = true; return; }
        if (results.length === 0) {
          box.innerHTML = '<div class="hero-search__empty">找不到相關文章，歡迎透過 LINE 直接詢問</div>';
          box.hidden = false;
          return;
        }
        box.innerHTML = results.slice(0, 8).map(r =>
          `<a href="${r.url}" class="hero-search__item">
            <span class="hero-search__type hero-search__type--${r.type === '案例' ? 'case' : 'article'}">${r.type}</span>
            <span class="hero-search__title">${r.title}</span>
          </a>`
        ).join('');
        box.hidden = false;
      }

      let timer;
      input.addEventListener('input', () => {
        clearTimeout(timer);
        timer = setTimeout(async () => {
          const kw = input.value.trim();
          if (!kw) { box.hidden = true; return; }
          const data = await loadIndex();
          const results = data.filter(item =>
            item.title.includes(kw) ||
            item.description.includes(kw) ||
            item.tags.some(t => t.includes(kw))
          );
          render(results, kw);
        }, 200);
      });

      input.addEventListener('focus', loadIndex);
      document.addEventListener('click', (e) => {
        if (!e.target.closest('.hero-search')) box.hidden = true;
      });
    })();
  </script>

  <style>
    .hero-search { position: relative; max-width: 480px; margin: 0 auto; }
    .hero-search__input {
      width: 100%; padding: 0.85rem 1.25rem; border-radius: 50px; border: none;
      font-size: 0.98rem; font-family: inherit; outline: none;
      box-shadow: 0 4px 20px rgba(0,0,0,0.25);
    }
    .hero-search__input:focus { box-shadow: 0 4px 24px rgba(59,169,156,0.45); }
    .hero-search__results {
      position: absolute; top: calc(100% + 8px); left: 0; right: 0;
      background: #fff; border-radius: 12px; overflow: hidden;
      box-shadow: 0 12px 40px rgba(0,0,0,0.2); z-index: 20;
      max-height: 320px; overflow-y: auto; text-align: left;
    }
    .hero-search__item {
      display: flex; align-items: center; gap: 0.6rem;
      padding: 0.75rem 1rem; color: var(--color-ink);
      border-bottom: 1px solid var(--color-line); transition: background 0.15s;
    }
    .hero-search__item:last-child { border-bottom: none; }
    .hero-search__item:hover { background: var(--color-accent-bg); }
    .hero-search__type {
      flex-shrink: 0; font-size: 0.72rem; padding: 0.1rem 0.5rem;
      border-radius: 4px; font-weight: 500;
    }
    .hero-search__type--case { background: #E8F5F3; color: #2D8F84; }
    .hero-search__type--article { background: #FFF4E0; color: #B07D2B; }
    .hero-search__title { font-size: 0.9rem; line-height: 1.4; }
    .hero-search__empty { padding: 1rem; color: var(--color-muted); font-size: 0.9rem; text-align: center; }
  </style>

  <!-- ===== 主治項目 ===== -->
  <section class="section">
    <div class="wrap">
      <div class="section__eyebrow">Specialties</div>
      <h2 class="section__title">主治項目</h2>
      <p class="section__subtitle">點擊細項可查看相關治療案例</p>
      <div class="spec-grid spec-grid--four">
        {SITE.specialties.map((s) => (
          <div class="spec-card">
            <div class="spec-card__icon">{s.icon}</div>
            <h3 class="spec-card__title">{s.group}</h3>
            <ul class="spec-card__list">
              {s.items.map((item) => (
                <li>
                  {existingTags.has(item.tag) ? (
                    <a href={`/cases/tag/${item.tag}/`} class="spec-link">{item.label}</a>
                  ) : (
                    <span>{item.label}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== 治療方式 ===== -->
  <section class="section section--alt">
    <div class="wrap">
      <div class="section__eyebrow">Treatments</div>
      <h2 class="section__title">治療方式</h2>
      <div class="tx-grid">
        {SITE.treatments.map((t) => (
          <span class="tx-chip" title={t.description}>{t.name}</span>
        ))}
      </div>
      <p class="tx-note">🩹 怕針也能處理 — 可選擇 AMCT 整脊或中藥調理</p>
    </div>
  </section>

  <!-- ===== 最新案例 ===== -->
  <section class="section">
    <div class="wrap">
      <div class="section__eyebrow">Cases</div>
      <h2 class="section__title">最新案例</h2>
      {recentCases.length === 0 ? (
        <p style="text-align:center; color:var(--color-muted);">案例即將上線，敬請期待。</p>
      ) : (
        <div class="post-grid">
          {recentCases.map((post) => (
            <div class="post-card">
              {post.data.cover ? (
                <img src={post.data.cover} alt={post.data.title} class="post-card__cover" loading="lazy" />
              ) : (
                <div class="post-card__cover--placeholder">📋</div>
              )}
              <div class="post-card__body">
                <div class="post-card__date">{fmtDate(post.data.publishDate)}</div>
                <h3 class="post-card__title"><a href={`/cases/${post.slug}/`}>{post.data.title}</a></h3>
                <p class="post-card__desc">{post.data.description}</p>
                <a href={`/cases/${post.slug}/`} class="post-card__link">閱讀更多</a>
              </div>
            </div>
          ))}
        </div>
      )}
      {recentCases.length > 0 && (
        <div style="text-align:center;"><a href="/cases/" class="view-all">查看全部案例</a></div>
      )}
    </div>
  </section>

  <!-- ===== 健康知識 ===== -->
  <section class="section section--alt">
    <div class="wrap">
      <div class="section__eyebrow">Health Tips</div>
      <h2 class="section__title">健康知識</h2>
      {recentArticles.length === 0 ? (
        <p style="text-align:center; color:var(--color-muted);">衛教文章即將上線，敬請期待。</p>
      ) : (
        <div class="post-grid">
          {recentArticles.map((post) => (
            <div class="post-card">
              {post.data.cover ? (
                <img src={post.data.cover} alt={post.data.title} class="post-card__cover" loading="lazy" />
              ) : (
                <div class="post-card__cover--placeholder">📖</div>
              )}
              <div class="post-card__body">
                <div class="post-card__date">{fmtDate(post.data.publishDate)}</div>
                <h3 class="post-card__title"><a href={`/articles/${post.slug}/`}>{post.data.title}</a></h3>
                <p class="post-card__desc">{post.data.description}</p>
                <a href={`/articles/${post.slug}/`} class="post-card__link">閱讀更多</a>
              </div>
            </div>
          ))}
        </div>
      )}
      {recentArticles.length > 0 && (
        <div style="text-align:center;"><a href="/articles/" class="view-all">查看全部文章</a></div>
      )}
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="cta-banner">
    <h2>預約看診</h2>
    <p>點擊下方按鈕，透過 LINE 官方帳號預約掛號</p>
    <a href={SITE.clinic.lineUrl} target="_blank" rel="noopener" class="cta-banner__btn">LINE 立即預約</a>
  </section>

  <!-- ===== 診所資訊 + 看診時間 ===== -->
  <section class="clinic-section">
    <div class="clinic-grid">
      <div>
        <h3>📍 {SITE.clinic.fullName}</h3>
        <p>{SITE.clinic.address}</p>
        <p>電話：{SITE.clinic.phone}</p>
        {SITE.clinic.googleMapUrl && (
          <p><a href={SITE.clinic.googleMapUrl} target="_blank" rel="noopener">在 Google Maps 上查看 →</a></p>
        )}
      </div>
      <div>
        <h3>🕐 看診時間</h3>
        <table class="hours-table">
          <thead>
            <tr>
              <th></th>
              {SITE.clinic.hours.map((h) => <th>{h.day}</th>)}
            </tr>
          </thead>
          <tbody>
            <tr>
              <td style="text-align:left; font-size:0.82rem; color:rgba(255,255,255,0.5); white-space:nowrap;">{SITE.clinic.amTime}</td>
              {SITE.clinic.hours.map((h) => (
                <td><span class={`hours-dot hours-dot--${h.am ? 'on' : 'off'}`}></span></td>
              ))}
            </tr>
            <tr>
              <td style="text-align:left; font-size:0.82rem; color:rgba(255,255,255,0.5); white-space:nowrap;">{SITE.clinic.pmTime}</td>
              {SITE.clinic.hours.map((h) => (
                <td><span class={`hours-dot hours-dot--${h.pm ? 'on' : 'off'}`}></span></td>
              ))}
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Base>
